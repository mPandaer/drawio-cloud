worker_processes auto;
pid /tmp/drawio-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    client_body_temp_path /tmp/drawio-client-body;
    proxy_temp_path /tmp/drawio-proxy;
    fastcgi_temp_path /tmp/drawio-fastcgi;
    uwsgi_temp_path /tmp/drawio-uwsgi;
    scgi_temp_path /tmp/drawio-scgi;
    server {
        listen 8080;
        server_name _;
        root /app/web;
        client_max_body_size __BODY_LIMIT__;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        location = /editor { return 308 /editor/$is_args$args; }
        location /editor/ {
            alias /app/editor/;
            index index.html;
        }
        location = /api { return 308 /api/$is_args$args; }
        location /api/ {
            proxy_pass http://127.0.0.1:3000;
            proxy_set_header Host $http_host;
            proxy_set_header Origin $http_origin;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            # The entrypoint owns the CSP header; direct API responses set it too.
            proxy_hide_header Content-Security-Policy;
            proxy_read_timeout 60s;
        }
        location ~ /\. { deny all; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
