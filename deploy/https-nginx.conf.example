# Install on the HTTPS gateway; replace the hostname, certificates and upstream.
server {
    listen 443 ssl;
    server_name draw.example.com;
    ssl_certificate /etc/ssl/draw.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/draw.example.com/privkey.pem;

    # 6 * MAX_DOCUMENT_BYTES + 65536, in bytes (default: 20 MiB document).
    client_max_body_size 125894656;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 60s;
    }
}
